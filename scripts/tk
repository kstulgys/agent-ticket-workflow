#!/usr/bin/env python3
"""tk: the ticket-workflow provider CLI. Standard library only."""
import os
import sys

# realpath, not abspath, so a symlink in a PATH directory still finds tk_lib.
# helpers.py resolves too, so both path setups agree.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from tk_lib import cli  # noqa: E402

if __name__ == "__main__":
    sys.exit(cli.main())
